# Dependencies
# Composer's dev dependencies at the REPO ROOT only. Anchored on purpose:
# unanchored, this also matched includes/vendors/mcp-adapter/vendor/, the
# adapter's php-mcp-schema runtime dependency that MUST ship in the plugin.
/vendor/

# Composer
composer.lock

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build output (bin/build-zip.sh)
dist/

# PHPUnit cache
.phpunit.cache/
.phpunit.result.cache

# Claude Code local settings
.claude/settings.local.json
.claude/settings.json

#Tests
releases/*
skills/*
#Security
.mcp.json

#Meta
docs/*

#Cross-session field reports (local working artifacts; codified canonically in code/PRs)
FIELD-*REPORT-*.md
